# Include nel VirtualHost HTTPS di TailTicket, PRIMA del ProxyPass generale verso Next.
# Serve solo se il Redirect URI Google originale rimane sulla porta 443 e il PHP è su 8443.
# Adattare host/porta e il bundle CA di sistema. Il plugin e Google Cloud restano invariati.
# Richiede mod_ssl, mod_proxy e mod_proxy_http.
SSLProxyEngine On
SSLProxyVerify require
SSLProxyVerifyDepth 5
SSLProxyCheckPeerName On
SSLProxyCACertificateFile /etc/ssl/certs/ca-certificates.crt

ProxyPass "/api/auth/oauth2" "https://ticket.responsible.hospital:8443/api/auth/oauth2" retry=0 connectiontimeout=5 timeout=60
ProxyPassReverse "/api/auth/oauth2" "https://ticket.responsible.hospital:8443/api/auth/oauth2"
